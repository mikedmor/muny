# Copy to .env and fill in. Never commit .env.

# 32+ byte random key used to encrypt bank/provider credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK THIS UP SEPARATELY - losing it means re-linking all bank connections.
MUNY_SECRET_KEY=

TZ=America/New_York
MUNY_PORT=8420
MUNY_DATA_DIR=./data-local
