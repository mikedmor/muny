# Copy to .env and fill in. Never commit .env.

# 32+ byte random key used to encrypt bank/provider credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK THIS UP SEPARATELY - losing it means re-linking all bank connections.
MUNY_SECRET_KEY=

TZ=America/New_York
MUNY_PORT=8420
MUNY_DATA_DIR=./data-local

# Automatic SQLite backups (defaults shown). Interval 0 turns them off.
# MUNY_BACKUP_DIR=./data-local/backups
# MUNY_BACKUP_KEEP=14
# MUNY_BACKUP_INTERVAL_HOURS=24

# Plaid (optional). Create a free personal-use account at https://dashboard.plaid.com/signup
# PLAID_ENV: sandbox (fake data) or production
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Teller (optional, US only). Sign up at https://teller.io - the free developer tier allows 100 bank logins.
# Teller authenticates API calls with a client certificate downloaded from the Teller dashboard.
# TELLER_ENV: sandbox (fake data) or development (real accounts, free)
TELLER_APPLICATION_ID=
TELLER_CERT_PATH=./data-local/teller/certificate.pem
TELLER_KEY_PATH=./data-local/teller/private_key.pem
TELLER_ENV=sandbox

# Deploy target for `pnpm deploy:nas` (see docs/DEPLOYMENT.md)
MUNY_DEPLOY_HOST=
MUNY_DEPLOY_PATH=/volume1/docker/muny
